"""Public event/type diagnostic only. Public markers; no encryption claim or database."""
import hashlib, json
from pathlib import Path
from uuid import UUID
import sqlalchemy
from sqlalchemy import Column, MetaData, Table, Text, Uuid, event, inspect
from sqlalchemy.engine import Engine, default
from sqlalchemy.engine.url import URL
from sqlalchemy.orm import Session, registry
from sqlalchemy.pool import StaticPool
from sqlalchemy.types import TypeDecorator
from sqlalchemy.exc import StatementError
from sqlalchemy.orm.attributes import NO_VALUE

MARKER = 'PUBLIC_DIAGNOSTIC_MARKER'
class Fault(Exception): pass
class DriverError(Exception): pass
class Cursor:
    description = None
    rowcount = 1
    lastrowid = None
    def __init__(self, seen): self.seen = seen
    def execute(self, statement, parameters): self.seen.append(dict(parameters))
    def executemany(self, statement, parameters):
        for p in parameters: self.execute(statement, p)
    def close(self): pass
class Connection:
    def __init__(self, seen): self.seen = seen
    def cursor(self): return Cursor(self.seen)
    def rollback(self): pass
    def commit(self): pass
    def close(self): pass
class DBAPI:
    paramstyle = 'named'
    Error = DriverError

def run(mode):
    seen, retained, stages, errors = [], [], [], []
    fault = Fault('public diagnostic fault')
    failing = True
    def identity(ctx):
        stages.append('default')
        retained.append((ctx, ctx.compiled_parameters, ctx.get_current_parameters()))
        return UUID(int=len(retained))
    class Value(TypeDecorator):
        impl = Text
        cache_ok = False
        def process_bind_param(self, value, dialect):
            stages.append('bind')
            if failing and mode in ('sealed_guard', 'bind_fault'): raise fault
            return value
    mapping = registry(metadata=MetaData())
    table = Table('probe', mapping.metadata, Column('id', Uuid, primary_key=True, default=identity), Column('value', Value()))
    class Row: pass
    mapping.map_imperatively(Row, table)
    engine = Engine(StaticPool(creator=lambda: Connection(seen)), default.DefaultDialect(dbapi=DBAPI()), URL.create('public_fake'), hide_parameters=True)
    @event.listens_for(engine, 'before_cursor_execute', retval=True)
    def cursor(conn, cursor, statement, params, context, many):
        stages.append('cursor')
        if failing and mode == 'cursor_fault': raise fault
        if mode == 'cursor_rewrite':
            params = dict(params)
            params['value'] = 'PUBLIC_REPLACEMENT'
        elif mode == 'in_place_scrub':
            for group in context.compiled_parameters: group['value'] = 'PUBLIC_REPLACEMENT'
        return statement, params
    @event.listens_for(engine, 'handle_error')
    def error(ctx): errors.append(ctx.original_exception is fault)
    row = Row(value=MARKER)
    session = Session(engine)
    session.add(row)
    try:
        session.flush()
    except Exception as exc:
        result = {'mode':mode, 'stages':list(stages), 'error_type':type(exc).__name__, 'exact_raw_fault':exc is fault, 'wrapped_exact_fault':isinstance(exc,StatementError) and exc.orig is fault, 'handle_error':list(errors), 'inactive':not session.is_active, 'transaction':session.in_transaction(), 'id_absent':inspect(row).attrs.id.loaded_value is NO_VALUE, 'driver_calls':len(seen)}
        assert result['inactive'] and result['transaction'] and result['id_absent'] and not seen
        session.rollback()
        assert session.is_active and not session.in_transaction()
        failing = False
        session.add(row)
        session.flush()
        result['retry_persistent'] = inspect(row).persistent
        result['callback_count_after_retry'] = len(retained)
        assert result['retry_persistent'] and len(retained) == 2
    else:
        ctx, groups, group = retained[0]
        result = {'mode':mode, 'list_identity':ctx.compiled_parameters is groups, 'retained_group_value':group['value'], 'context_value':ctx.compiled_parameters[0]['value'], 'driver_value':seen[0]['value'], 'orm_value':row.value}
    session.close()
    engine.dispose()
    mapping.dispose()
    return result

pins = json.loads((Path(__file__).resolve().parent.parent / 'candidate-opaque-routing-feasibility-r2-20261014/experiments/opaque_source_hashes.json').read_text())[sqlalchemy.__version__]
root = Path(sqlalchemy.__file__).parent
assert all(hashlib.sha256((root / p).read_bytes()).hexdigest() == digest for p,digest in pins.items())
results = [run(mode) for mode in ('native', 'sealed_guard', 'bind_fault', 'cursor_fault', 'cursor_rewrite', 'in_place_scrub')]
assert results[1]['stages'] == ['default','bind']
assert results[2]['wrapped_exact_fault'] and results[2]['handle_error'] == [True]
assert results[3]['exact_raw_fault'] and results[3]['handle_error'] == []
assert results[4]['list_identity'] and results[4]['context_value'] == MARKER and results[4]['driver_value'] == 'PUBLIC_REPLACEMENT'
assert results[5]['list_identity'] and results[5]['retained_group_value'] == 'PUBLIC_REPLACEMENT'
print(json.dumps({'sqlalchemy':sqlalchemy.__version__,'source_pins_verified':len(pins),'cases':results},indent=2))
